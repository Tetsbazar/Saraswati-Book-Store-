ocked' : ''} en-font\">${isLocked ? 'সম্পূর্ণ' : attemptCount + '/' + MAX_ATTEMPTS}</div>`;\n        }\n        \n        card.innerHTML = `\n            ${badge}\n            <div class=\"set-icon\">${set.icon}</div>\n            <div class=\"set-name\">${set.name}</div>\n            <div class=\"set-topic\">${set.topic}</div>\n            <div class=\"set-meta-info en-font\">\n                <span>${set.questions.length} Qs</span>\n                <span>10 Mins</span>\n            </div>\n        `;\n        card.onclick = () => { selectSet(id); };\n        grid.appendChild(card);\n    }\n}\n\nfunction selectSet(setId) {\n    if(loggedInUser) {\n        let userAttempts = JSON.parse(localStorage.getItem(STORAGE_KEY_ATTEMPTS)) || {};\n        let attemptCount = userAttempts[loggedInUser + \"_\" + setId] || 0;\n        if(attemptCount >= MAX_ATTEMPTS) {\n            alert(`⚠️ আপনি এই সেটের সর্বোচ্চ ${MAX_ATTEMPTS} বার Test দিয়েছেন।`);\n            return;\n        }\n        startQuiz(setId);\n    } else {\n        currentSetId = setId;\n        document.getElementById('loginUsername').value = '';\n        document.getElementById('loginPassword').value = '';\n        document.getElementById('loginError').classList.add('hidden');\n        document.getElementById('loginSetName').innerText = QUIZ_SETS[setId].name + \": \" + QUIZ_SETS[setId].topic;\n        document.getElementById('loginModal').classList.remove('hidden');\n    }\n}\n\nfunction closeLogin() { document.getElementById('loginModal').classList.add('hidden'); }\n\nfunction doLogin() {\n    const u = document.getElementById('loginUsername').value.trim();\n    const p = document.getElementById('loginPassword').value.trim();\n    const err = document.getElementById('loginError');\n    const GLOBAL_USERS = JSON.parse(localStorage.getItem(\"testBazarGlobalUsers\")) || {};\n    \n    if(!u || !p) { err.innerText = \"ইউজারনেম এবং পাসওয়ার্ড দিন!\"; err.classList.remove('hidden'); return; }\n    \n    if(GLOBAL_USERS[u] && GLOBAL_USERS[u] === p) {\n        loggedInUser = u;\n        document.getElementById('userDisplay').innerText = `👤 ${u}`;\n        closeLogin();\n        buildHub();\n        if(currentSetId) {\n            startQuiz(currentSetId);\n        }\n    } else {\n        err.innerText = \"ইউজারনেম বা পাসওয়ার্ড ভুল!\";\n        err.classList.remove('hidden');\n    }\n}\n\nfunction incrementAttempt(user, setId) {\n    let userAttempts = JSON.parse(localStorage.getItem(STORAGE_KEY_ATTEMPTS)) || {};\n    let key = user + \"_\" + setId;\n    userAttempts[key] = (userAttempts[key] || 0) + 1;\n    localStorage.setItem(STORAGE_KEY_ATTEMPTS, JSON.stringify(userAttempts));\n}\n\nfunction startQuiz(setId) {\n    currentSetId = setId;\n    incrementAttempt(loggedInUser, setId);\n    questions = QUIZ_SETS[setId].questions;\n    userAnswers = {};\n    isReviewMode = false;\n    score = 0;\n    wrongAnswers = 0;\n    timeLeft = TIME_LIMIT;\n    \n    document.getElementById('hubView').classList.add('hidden');\n    document.getElementById('resultModal').classList.add('hidden');\n    document.getElementById('quizView').classList.remove('hidden');\n    document.getElementById('timerBox').classList.remove('hidden');\n    document.getElementById('timerBox').classList.remove('danger');\n    document.getElementById('submitTestBtn').classList.remove('hidden');\n    document.getElementById('quizTitle').innerText = QUIZ_SETS[setId].name + \" | \" + QUIZ_SETS[setId].topic;\n    \n    clearInterval(timerInterval);\n    timerInterval = setInterval(tick, 1000);\n    renderQuestions();\n}\n\nfunction tick() {\n    timeLeft--;\n    const m = Math.floor(timeLeft / 60);\n    const s = timeLeft % 60;\n    document.getElementById('timerDisplay').textContent = m + ':' + (s < 10 ? '0' : '') + s;\n    if (timeLeft <= 60) document.getElementById('timerBox').classList.add('danger');\n    if (timeLeft <= 0) { submitQuiz(); }\n}\n\nconst LABELS = ['A', 'B', 'C', 'D'];\n\nfunction renderQuestions() {\n    const quizList = document.getElementById('quizList');\n    let html = '';\n    questions.forEach((q, i) => {\n        html += `<div class=\"q-block\" id=\"qBlock_${i}\">\n            <div class=\"q-text\">${q.q}</div>\n            <div class=\"options-grid\">`;\n        q.opts.forEach((opt, j) => {\n            html += `<div class=\"opt\" id=\"opt_${i}_${j}\" onclick=\"selectOpt(${i}, ${j})\">\n                <div class=\"opt-circle\">${LABELS[j]}</div>\n                <div class=\"opt-text\">${opt}</div>\n            </div>`;\n        });\n        html += `</div>\n            <div class=\"explanation hidden\" id=\"exp_${i}\">${q.exp}</div>\n        </div>`;\n    });\n    quizList.innerHTML = html;\n    window.scrollTo(0, 0);\n}\n\nfunction selectOpt(qIdx, optIdx) {\n    if (isReviewMode) return;\n    userAnswers[qIdx] = optIdx;\n    const block = document.getElementById(`qBlock_${qIdx}`);\n    const opts = block.querySelectorAll('.opt');\n    opts.forEach(o => o.classList.remove('selected'));\n    document.getElementById(`opt_${qIdx}_${optIdx}`).classList.add('selected');\n}\n\nfunction submitQuiz() {\n    if (isReviewMode) return;\n    const answeredCount = Object.keys(userAnswers).length;\n    if (timeLeft > 0 && answeredCount < questions.length) {\n        const confirmSubmit = confirm(`আপনি মাত্র ${answeredCount} টি প্রশ্নের উত্তর দিয়েছেন। আপনি কি সত্যিই Test জমা দিতে চান?`);\n        if(!confirmSubmit) return;\n    }\n    isReviewMode = true;\n    clearInterval(timerInterval);\n    document.getElementById('timerBox').classList.add('hidden');\n    document.getElementById('submitTestBtn').classList.add('hidden');\n    \n    score = 0;\n    wrongAnswers = 0;\n    questions.forEach((q, i) => {\n        const selected = userAnswers[i];\n        const block = document.getElementById(`qBlock_${i}`);\n        const opts = block.querySelectorAll('.opt');\n        opts.forEach(o => o.classList.remove('selected'));\n        if (selected !== undefined) {\n            if (selected === q.ans) {\n                score++;\n                document.getElementById(`opt_${i}_${selected}`).classList.add('correct');\n            } else {\n                wrongAnswers++;\n                document.getElementById(`opt_${i}_${selected}`).classList.add('wrong');\n                document.getElementById(`opt_${i}_${q.ans}`).classList.add('correct');\n            }\n        } else {\n            document.getElementById(`opt_${i}_${q.ans}`).classList.add('correct');\n        }\n        document.getElementById(`exp_${i}`).classList.remove('hidden');\n    });\n    \n    const skipped = questions.length - (score + wrongAnswers);\n    const pct = Math.round((score / questions.length) * 100);\n    document.getElementById('finalScore').textContent = `${pct}%`;\n    document.getElementById('rbCorrect').textContent = score;\n    document.getElementById('rbWrong').textContent = wrongAnswers + skipped;\n    \n    let icon = '💪', grade = 'চেষ্টা চালিয়ে যাও!';\n    if(pct >= 90) { icon = '🌟'; grade = 'অসাধারণ!'; }\n    else if(pct >= 70) { icon = '👍'; grade = 'খুব ভালো!'; }\n    else if(pct >= 50) { icon = '📚'; grade = 'ভালো চেষ্টা!'; }\n    \n    document.getElementById('resultIcon').textContent = icon;\n    document.getElementById('resultGrade').textContent = grade;\n    \n    let userAttempts = JSON.parse(localStorage.getItem(STORAGE_KEY_ATTEMPTS)) || {};\n    let attemptCount = userAttempts[loggedInUser + \"_\" + currentSetId] || 0;\n    let remaining = MAX_ATTEMPTS - attemptCount;\n    document.getElementById('attemptInfo').innerText = `বাকি আছে ${remaining} বার Test দেওয়ার সুযোগ (সর্বোচ্চ ${MAX_ATTEMPTS} বার)`;\n    document.getElementById('resultModal').classList.remove('hidden');\n}\n\nfunction closeResultModal() {\n    document.getElementById('resultModal').classList.add('hidden');\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n}\n\nfunction restartQuiz() {\n    closeResultModal();\n    let userAttempts = JSON.parse(localStorage.getItem(STORAGE_KEY_ATTEMPTS)) || {};\n    let attemptCount = userAttempts[loggedInUser + \"_\" + currentSetId] || 0;\n    if(attemptCount >= MAX_ATTEMPTS) {\n        alert(`⚠️ আপনি এই সেটের সর্বোচ্চ ${MAX_ATTEMPTS} বার Test দিয়েছেন।`);\n        document.getElementById('quizView').classList.add('hidden');\n        document.getElementById('hubView').classList.remove('hidden');\n        buildHub();\n        return;\n    }\n    startQuiz(currentSetId);\n}\n</script>\n</body>\n</html>
